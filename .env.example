# Reference only: fund_monitor.py does not automatically load this file.
# Export these variables in your shell or configure them as GitHub Actions secrets/variables.

APP_TIMEZONE=Asia/Shanghai
TRADING_CALENDAR_CODE=XSHG

SENDER_EMAIL=your-email@example.com
SENDER_PASS=your-smtp-app-password
RECEIVER_GROUP_A=recipient-a@example.com
RECEIVER_GROUP_B=recipient-b@example.com

SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_FALLBACK_PORT=587
SMTP_TIMEOUT=15
SMTP_RETRY_COUNT=2
SMTP_RETRY_DELAY=3

HTTP_RETRY_COUNT=2
HTTP_RETRY_DELAY=1

# Optional proxy settings:
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
